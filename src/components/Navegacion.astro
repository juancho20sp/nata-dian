---
import { DESTINOS, destinoActivo } from '../lib/destinos';
import { ruta } from '../lib/ruta';
import Buscador from './Buscador.astro';

const activo = destinoActivo(Astro.url.pathname, import.meta.env.BASE_URL);
---

<header class="no-imprimir sticky top-0 z-40 border-b border-borde bg-superficie/95 backdrop-blur">
  <nav aria-label="Principal" class="max-w-5xl mx-auto px-4">
    <div class="flex items-center gap-2 h-14">
      <a href={ruta('/')} class="font-bold text-texto no-underline mr-auto leading-tight">
        Estudio DIAN 2676
        <span class="block text-xs font-normal text-suave">Sitio no oficial</span>
      </a>
      <ul class="hidden lg:flex items-center gap-1 text-[0.95rem]">
        {
          DESTINOS.map((d) => (
            <li>
              <a
                href={ruta(d.href)}
                aria-current={d === activo ? 'page' : undefined}
                class="px-2 py-1.5 rounded no-underline text-texto hover:bg-superficie-2 aria-[current=page]:bg-primario-suave aria-[current=page]:text-primario aria-[current=page]:font-semibold"
              >
                {d.texto}
              </a>
            </li>
          ))
        }
      </ul>
      <Buscador />
      <button
        type="button"
        id="boton-tema"
        class="p-2 rounded hover:bg-superficie-2 text-texto"
        aria-label="Cambiar entre modo claro y oscuro"
        title="Cambiar tema"
      >
        <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  import { CLAVES, escribir } from '../lib/almacen';

  const raiz = document.documentElement;
  document.getElementById('boton-tema')?.addEventListener('click', () => {
    const oscuroAhora =
      raiz.dataset.theme === 'dark' ||
      (!raiz.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    const nuevo = oscuroAhora ? 'light' : 'dark';
    raiz.dataset.theme = nuevo;
    escribir(CLAVES.tema, nuevo);
  });
</script>

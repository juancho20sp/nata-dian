---
import { getEntry, render } from 'astro:content';
import Plegable from './Plegable.astro';

interface Props {
  /** Nombre del archivo en src/content/paginas sin extensión. */
  pagina: string;
  /** Id de la sección (ancla). Por defecto, el nombre del archivo. */
  id?: string;
  /** Reemplaza el título del frontmatter (p. ej. cuando repetiría el de la página). */
  titulo?: string;
  /** Muestra el Markdown dentro de una sección plegable (por defecto) o abierto. */
  plegable?: boolean;
  /** Solo sin plegable: muestra el título del frontmatter como encabezado. */
  conTitulo?: boolean;
  nivel?: 'h1' | 'h2';
}

const { pagina, id = pagina, titulo, plegable = true, conTitulo = true, nivel = 'h2' } = Astro.props;
const entrada = await getEntry('paginas', pagina);
if (!entrada) throw new Error(`No existe src/content/paginas/${pagina}.md`);
const { Content } = await render(entrada);
const Encabezado = nivel;
---

{
  plegable ? (
    <Plegable id={id} titulo={titulo ?? entrada.data.titulo} resumen={entrada.data.resumen} aviso={entrada.data.aviso}>
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </Plegable>
  ) : (
    <section aria-labelledby={conTitulo ? id : undefined} class="mt-8 first:mt-0">
      {conTitulo && (
        <Encabezado id={id} class={nivel === 'h1' ? 'text-3xl font-bold mb-4' : 'text-2xl font-bold mb-3'}>
          {titulo ?? entrada.data.titulo}
        </Encabezado>
      )}
      <div class="prose prose-lg max-w-none">
        <Content />
      </div>
    </section>
  )
}

---
import { DESTINOS, destinoActivo, type Icono } from '../lib/destinos';
import { ruta } from '../lib/ruta';

const activo = destinoActivo(Astro.url.pathname, import.meta.env.BASE_URL);

// Trazos de 24 × 24, estilo de línea.
const ICONOS: Record<Icono, string> = {
  inicio: 'M3 11.5 12 4l9 7.5M5.5 9.5V20h13V9.5',
  prueba: 'M8 4h8M9 4v2h6V4M6 6h12v14H6zM9 11h6M9 15h4',
  normativa: 'M5 4h10l4 4v12H5zM15 4v4h4M8 12h8M8 16h8',
  convocatoria: 'M4 7h16v12H4zM9 7V5h6v2M4 12h16',
  repasar: 'M8 7h11v13H8zM5 17V4h11',
  plan: 'M5 5h14v15H5zM5 9h14M9 3v4M15 3v4M8 13l2 2 4-4',
};
---

<nav
  aria-label="Secciones"
  class="no-imprimir lg:hidden fixed inset-x-0 bottom-0 z-40 border-t border-borde bg-superficie pb-[env(safe-area-inset-bottom)]"
>
  <ul class="grid grid-cols-6 max-w-xl mx-auto">
    {
      DESTINOS.map((d) => {
        const esActivo = d === activo;
        return (
          <li>
            <a
              href={ruta(d.href)}
              aria-current={esActivo ? 'page' : undefined}
              class="flex min-h-14 flex-col items-center justify-center gap-0.5 px-0 py-1.5 text-[clamp(0.54rem,2.9vw,0.75rem)] leading-tight font-medium whitespace-nowrap no-underline text-suave aria-[current=page]:text-primario aria-[current=page]:shadow-[inset_0_3px_0_var(--primario)]"
            >
              <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d={ICONOS[d.icono]} />
              </svg>
              <span class="text-center">{d.corto}</span>
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

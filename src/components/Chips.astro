---
/**
 * Grupo de chips de selección única. Al tocar uno, marca aria-pressed y emite
 * en el contenedor el evento `cambio-chip` con `detail.valor`.
 * Sin JavaScript el grupo queda oculto (hidden) y la página muestra todo.
 */
interface Props {
  id: string;
  etiqueta: string;
  opciones: readonly { valor: string; texto: string }[];
  activo: string;
  /** En móvil, una sola fila que se desplaza de lado (para grupos largos). */
  desplazable?: boolean;
}
const { id, etiqueta, opciones, activo, desplazable = false } = Astro.props;
---

<div
  id={id}
  role="group"
  aria-label={etiqueta}
  class:list={[
    'no-imprimir flex gap-2',
    desplazable ? 'chips-desplazables flex-nowrap overflow-x-auto sm:flex-wrap sm:overflow-visible' : 'flex-wrap',
  ]}
  data-chips
  hidden
>
  {
    opciones.map((o) => (
      <button type="button" class="chip shrink-0" data-valor={o.valor} aria-pressed={o.valor === activo ? 'true' : 'false'}>
        {o.texto}
      </button>
    ))
  }
</div>

<script>
  for (const grupo of document.querySelectorAll<HTMLElement>('[data-chips]')) {
    grupo.hidden = false;
    grupo.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-valor]');
      if (!chip || chip.getAttribute('aria-pressed') === 'true') return;
      for (const b of grupo.querySelectorAll('button[data-valor]')) b.setAttribute('aria-pressed', String(b === chip));
      grupo.dispatchEvent(new CustomEvent('cambio-chip', { detail: { valor: chip.dataset.valor } }));
    });
  }
</script>

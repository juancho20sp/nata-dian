---
import '../styles/global.css';
import Navegacion from '../components/Navegacion.astro';
import Pie from '../components/Pie.astro';
import BarraInferior from '../components/BarraInferior.astro';

interface Props {
  titulo: string;
  descripcion?: string;
  /** Excluye la página del índice de búsqueda. */
  sinIndice?: boolean;
}

const { titulo, descripcion = 'Sitio de estudio no oficial para la prueba escrita del Proceso de Selección DIAN 2676 (CNSC).', sinIndice = false } = Astro.props;
const tituloCompleto = titulo === 'Inicio' ? 'Estudio DIAN 2676' : `${titulo} · Estudio DIAN 2676`;
---

<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#1d4e89" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <title>{tituloCompleto}</title>
    <script is:inline>
      // Aplica el tema guardado antes de pintar para evitar parpadeo.
      try {
        var t = JSON.parse(localStorage.getItem('dian2676:tema') || 'null');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen flex flex-col font-sans pb-[calc(4.5rem+env(safe-area-inset-bottom))] lg:pb-0">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-superficie focus:px-3 focus:py-2 focus:rounded"
      >Saltar al contenido</a
    >
    <Navegacion />
    <main id="contenido" class="flex-1 w-full max-w-5xl mx-auto px-4 pt-6 pb-12" data-pagefind-body={sinIndice ? undefined : ''}>
      <slot />
    </main>
    <Pie />
    <BarraInferior />
  </body>
</html>

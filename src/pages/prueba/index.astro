---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Prosa from '../../components/Prosa.astro';
import LoEsencial from '../../components/LoEsencial.astro';
import Plegable from '../../components/Plegable.astro';
import { ruta } from '../../lib/ruta';

const filas = (await getCollection('ponderacion')).map((e) => e.data);
const orden = ['ingreso-con-experiencia', 'ingreso-sin-experiencia', 'ingreso-reserva-discapacidad', 'ascenso-con-experiencia', 'ascenso-sin-experiencia', 'ascenso-reserva-discapacidad'];
filas.sort((a, b) => orden.indexOf(a.id) - orden.indexOf(b.id));
const pct = (n: number | null) => (n === null ? 'No aplica' : `${n} %`);

const subpaginas = [
  { href: '/prueba/dia', pregunta: '¿Qué llevo y a qué hora llego?', texto: 'Horarios, documento, qué llevar y reclamaciones.' },
  { href: '/prueba/practicar', pregunta: '¿Cómo practico?', texto: 'Cómo resolver un ítem de juicio situacional y dónde hay preguntas oficiales.' },
];
---

<Base titulo="La prueba">
  <h1 class="text-3xl font-bold mb-2">La prueba</h1>

  <LoEsencial pagina="prueba" />

  <Prosa pagina="estructura-prueba" id="estructura" />

  <Plegable
    id="calificacion"
    titulo="Calificación y ponderación"
    resumen="Cuánto pesa cada prueba según la modalidad y el tipo de empleo."
  >
    <table class="tabla tabla-tarjetas">
      <caption class="sr-only">Peso de cada prueba según modalidad y tipo de empleo</caption>
      <thead>
        <tr>
          <th scope="col">Modalidad y tipo de empleo</th>
          <th scope="col">Funcionales</th>
          <th scope="col">Comportamentales</th>
          <th scope="col">Integridad</th>
          <th scope="col">Antecedentes</th>
        </tr>
      </thead>
      <tbody>
        {
          filas.map((f) => (
            <tr>
              <th scope="row" class="!normal-case !text-base !tracking-normal !text-texto !bg-transparent font-semibold">
                {f.modalidad}, {f.tipoEmpleo.charAt(0).toLowerCase() + f.tipoEmpleo.slice(1)}
              </th>
              <td data-label="Funcionales" class="font-semibold">{pct(f.funcionales)}</td>
              <td data-label="Comportamentales">{pct(f.comportamentales)}</td>
              <td data-label="Integridad">{pct(f.integridad)}</td>
              <td data-label="Antecedentes">{pct(f.antecedentes)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <div class="mt-3">
      <Prosa pagina="ponderacion-nota" plegable={false} conTitulo={false} />
    </div>
  </Plegable>

  <h2 class="text-xl font-bold mt-8 mb-3">Más sobre la prueba</h2>
  <ul class="grid gap-3 sm:grid-cols-2">
    {
      subpaginas.map((s) => (
        <li>
          <a href={ruta(s.href)} class="tarjeta block h-full no-underline hover:border-primario">
            <span class="block text-lg font-semibold text-primario">{s.pregunta} →</span>
            <span class="block text-suave">{s.texto}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

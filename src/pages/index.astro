---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { planesSeleccionables } from '../lib/datos';
import { FECHA_PRUEBA } from '../lib/fechas';
import { ruta } from '../lib/ruta';

const datosClave = [
  { valor: 'DIAN 2676', etiqueta: 'Proceso de la CNSC' },
  { valor: '70/100', etiqueta: 'Mínimo en funcionales' },
  { valor: '5 horas', etiqueta: 'De 8:00 a. m. a 1:00 p. m.' },
  { valor: '3 opciones', etiqueta: 'Por pregunta (A, B, C)' },
];

const preguntas = [
  { href: '/prueba/dia', pregunta: '¿Qué llevo y a qué hora llego el día de la prueba?', texto: 'Horarios, documento y qué llevar.' },
  { href: '/prueba#calificacion', pregunta: '¿Cómo se califica y cuánto necesito?', texto: 'La prueba funcional es eliminatoria: mínimo 70/100.' },
  { href: '/normativa', pregunta: '¿Qué norma estudio para este tema?', texto: 'Normas por área y por tipo de empleo.' },
  { href: '/convocatoria#empleos', pregunta: '¿Qué empleos aplican para un abogado?', texto: 'Gestor o Inspector con Derecho y afines.' },
  { href: '/prueba/practicar', pregunta: '¿Dónde practico con preguntas oficiales?', texto: 'Guías de procesos anteriores y el método de juicio situacional.' },
];

const pendientes = [
  'Número de OPEC y denominación del empleo inscrito (SIMO, "Mis empleos inscritos").',
  'Indicadores temáticos del empleo, descargados del portal de Areandina con el número de inscripción.',
  'Confirmar la citación en SIMO (sitio y hora) apenas se publique.',
];

const idsTarjetas = (await getCollection('tarjetas')).map((e) => e.data.id);
const planes = await planesSeleccionables();
const datosPlanes = JSON.stringify(
  Object.fromEntries(
    planes.map((p) => [p.slug, { nombre: p.tituloCorto, semanas: p.semanas.map(({ id, inicio, fin, temas }) => ({ id, inicio, fin, temas })) }]),
  ),
);
---

<Base titulo="Inicio">
  <section aria-labelledby="titulo-dia-prueba" class="tarjeta border-l-4 border-l-aviso-borde mb-6" id="bloque-dia-prueba" data-fecha={FECHA_PRUEBA} hidden>
    <h2 id="titulo-dia-prueba" class="text-2xl font-bold">Hoy es la prueba</h2>
    <p class="mt-1">Puertas abren 7:15 a. m., inicio 8:00 a. m., cierre de puertas 8:30 a. m.</p>
    <p class="mt-3"><a href={ruta('/prueba/dia')} class="boton boton-primario">Qué llevar y qué no</a></p>
  </section>

  <section aria-labelledby="titulo-inicio" class="mb-6">
    <p class="text-suave font-medium text-sm">Prueba escrita · Proceso de Selección DIAN 2676</p>
    <h1 id="titulo-inicio" class="text-2xl sm:text-4xl font-bold leading-tight mt-1">
      Domingo 8 de noviembre de 2026, 8:00 a. m.
    </h1>

    <div class="tarjeta mt-4" aria-live="polite" id="cuenta-regresiva">
      <p class="text-sm font-semibold uppercase tracking-wide text-suave" data-faltan>Faltan</p>
      <div class="flex items-end gap-6 mt-1" data-activo hidden>
        <p><span class="text-5xl font-bold tabular-nums" data-dias>—</span> <span class="text-lg">días</span></p>
        <p><span class="text-5xl font-bold tabular-nums" data-horas>—</span> <span class="text-lg">horas</span></p>
      </div>
      <p class="text-2xl font-bold mt-1" data-fase="en-curso" hidden>La prueba está en curso (termina a la 1:00 p. m.).</p>
      <p class="text-2xl font-bold mt-1" data-fase="terminada" hidden>
        La prueba terminó. Los resultados y las reclamaciones van por <a href="https://simo.cnsc.gov.co/" rel="noopener">SIMO</a>.
      </p>
      <noscript><p class="mt-1">Active JavaScript para ver la cuenta regresiva.</p></noscript>
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 mt-3 pt-3 border-t border-borde">
        {
          datosClave.map((d) => (
            <li>
              <span class="block font-bold text-primario">{d.valor}</span>
              <span class="block text-sm text-suave leading-snug">{d.etiqueta}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <p class="mt-3" id="linea-repaso" data-ids={JSON.stringify(idsTarjetas)} hidden>
      <a href={ruta('/repasar')} class="block no-underline">
        <span class="block text-sm font-semibold uppercase tracking-wide text-suave">Repasar</span>
        <span class="block text-texto underline decoration-primario/50 underline-offset-4" data-texto-repaso></span>
      </a>
    </p>

    <p class="mt-3" id="linea-semana" data-planes={datosPlanes} hidden>
      <a href={ruta('/plan')} class="block no-underline">
        <span class="block text-sm font-semibold uppercase tracking-wide text-suave" data-semana-n></span>
        <span class="block text-texto underline decoration-primario/50 underline-offset-4" data-semana-temas></span>
      </a>
    </p>
  </section>

  <section aria-labelledby="titulo-preguntas" class="mb-8">
    <h2 id="titulo-preguntas" class="text-xl font-bold mb-3">¿Qué necesita consultar?</h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {
        preguntas.map((q) => (
          <li>
            <a href={ruta(q.href)} class="tarjeta block h-full no-underline hover:border-primario">
              <span class="block text-lg font-semibold leading-snug text-primario">{q.pregunta}</span>
              <span class="block mt-1 text-suave">{q.texto}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="titulo-falta">
    <h2 id="titulo-falta" class="text-xl font-bold mb-3">Lo que falta</h2>
    <div class="tarjeta border-l-4 border-l-aviso-borde">
      <ul class="space-y-2">
        {
          pendientes.map((p) => (
            <li class="flex gap-3">
              <span aria-hidden="true" class="mt-1 inline-block w-4 h-4 shrink-0 rounded border-2 border-suave" />
              <span>{p}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-3 text-sm text-suave">
        Sin la OPEC no se sabe a qué subproceso pertenece el empleo. Mientras tanto, use el{' '}
        <a href={ruta('/planes/por-defecto')}>plan por defecto</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import { CLAVES, leer } from '../lib/almacen';
  import { panelDeHoy } from '../lib/esta-semana';
  import { FECHA_PRUEBA, cuentaRegresiva, fasePrueba, fechaEnColombia, type RangoSemana } from '../lib/fechas';
  import { planDestino } from '../lib/plan-elegido';
  import { metaValida, racha, type Registro } from '../lib/racha';
  import { estadosVigentes, tocaHoy } from '../lib/repaso';
  import { propiasValidas } from '../lib/tarjetas-propias';

  // Cuenta regresiva
  const caja = document.getElementById('cuenta-regresiva');
  const activo = caja?.querySelector<HTMLElement>('[data-activo]');
  const faltan = caja?.querySelector<HTMLElement>('[data-faltan]');
  const fases = [...(caja?.querySelectorAll<HTMLElement>('[data-fase]') ?? [])];
  const dias = caja?.querySelector('[data-dias]');
  const horas = caja?.querySelector('[data-horas]');
  let temporizador: ReturnType<typeof setInterval> | undefined;

  function actualizar() {
    const ahora = new Date();
    const r = cuentaRegresiva(ahora);
    const fase = fasePrueba(ahora);
    if (activo) activo.hidden = fase !== 'pendiente';
    if (faltan) faltan.hidden = fase !== 'pendiente';
    for (const f of fases) f.hidden = f.dataset.fase !== fase;
    if (fase === 'terminada' && temporizador) clearInterval(temporizador);
    if (dias) dias.textContent = String(r.dias);
    if (horas) horas.textContent = String(r.horas);
  }

  temporizador = setInterval(actualizar, 30_000);
  actualizar();

  // El día de la prueba, la logística va primero
  const bloqueDia = document.getElementById('bloque-dia-prueba');
  if (bloqueDia) bloqueDia.hidden = fechaEnColombia(new Date()) !== bloqueDia.dataset.fecha;

  // Repaso: tarjetas para hoy y racha (se oculta después del día de la prueba)
  const lineaRepaso = document.getElementById('linea-repaso');
  const diaHoy = fechaEnColombia(new Date());
  if (lineaRepaso && diaHoy <= FECHA_PRUEBA) {
    let ids: string[] = [];
    try {
      ids = JSON.parse(lineaRepaso.dataset.ids ?? '[]');
    } catch {
      /* sin tarjetas */
    }
    ids = [...ids, ...propiasValidas(leer<unknown>(CLAVES.tarjetasPropias, [])).map((t) => t.id)];
    const estados = estadosVigentes(leer<unknown>(CLAVES.tarjetasEstado, {}), ids);
    const registroGuardado = leer<unknown>(CLAVES.repasoDias, {});
    const registro = registroGuardado && typeof registroGuardado === 'object' ? (registroGuardado as Registro) : {};
    const n = ids.filter((id) => tocaHoy(estados[id], diaHoy)).length;
    const d = racha(registro, metaValida(leer<unknown>(CLAVES.repasoMeta, null)), diaHoy).dias;
    lineaRepaso.querySelector('[data-texto-repaso]')!.textContent =
      `Hoy: ${n} ${n === 1 ? 'tarjeta' : 'tarjetas'} para repasar · racha de ${d} ${d === 1 ? 'día' : 'días'}`;
    lineaRepaso.hidden = false;
  }

  // Semana en curso del plan elegido (o del plan por defecto)
  const linea = document.getElementById('linea-semana');
  if (linea) {
    type DatosPlan = { nombre: string; semanas: (RangoSemana & { temas: string })[] };
    let planes: Record<string, DatosPlan> = {};
    try {
      planes = JSON.parse(linea.dataset.planes ?? '{}');
    } catch {
      /* sin datos */
    }
    const plan = planes[planDestino(leer<unknown>(CLAVES.plan, null), Object.keys(planes))];
    if (plan) {
      const panel = panelDeHoy(plan.semanas, new Date());
      if (panel.tipo === 'semana') {
        const semana = plan.semanas[panel.indice]!;
        linea.querySelector('[data-semana-n]')!.textContent = `Semana ${panel.indice + 1} de ${plan.semanas.length}`;
        linea.querySelector('[data-semana-temas]')!.textContent = `${plan.nombre}: ${semana.temas} →`;
        linea.hidden = false;
      }
    }
  }
</script>

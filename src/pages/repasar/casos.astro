---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chips from '../../components/Chips.astro';
import { ruta } from '../../lib/ruta';

const reglas = new Map((await getCollection('reglas')).map((e) => [e.data.id, e.data]));
const casos = (await getCollection('casos')).map(({ data: c }) => ({
  ...c,
  fuentes: c.reglas.map((id) => {
    const r = reglas.get(id);
    if (!r) throw new Error(`El caso ${c.id} remite a una regla inexistente: ${id}`);
    return { norma: r.norma, url: r.url };
  }),
}));

const NOMBRES = { A: 'A · Fiscalización', B: 'B · Cobranzas', C: 'C · Jurídica', D: 'D · Aduanas', T: 'Tronco común' } as const;
---

<Base titulo="Casos de práctica" descripcion="Casos de práctica de tres opciones sobre fiscalización, cobranzas, jurídica, aduanas y el tronco común.">
  <script type="application/json" id="datos-casos" set:html={JSON.stringify(casos).replace(/</g, '\\u003c')} />
  <nav aria-label="Migas" class="no-imprimir text-sm mb-1">
    <a href={ruta('/repasar')}>← Repasar</a>
  </nav>
  <h1 class="text-2xl font-bold mb-1">Casos de práctica</h1>
  <p class="text-suave text-sm mb-3">
    Un caso, una pregunta y tres opciones, como en la prueba. La CNSC no publica las preguntas reales; estos casos se escribieron
    para el sitio a partir de reglas verificadas en el texto oficial de cada norma.
  </p>

  <noscript><p class="tarjeta">Los casos de práctica necesitan JavaScript.</p></noscript>
  <p class="tarjeta border-l-4 border-l-aviso-borde mb-3 text-sm" id="aviso-almacen" hidden>Este navegador no guarda el avance.</p>

  <div id="casos" hidden>
    <Chips
      id="chips-caso"
      etiqueta="Filtrar por caso"
      activo="todos"
      desplazable
      opciones={[{ valor: 'todos', texto: 'Todos' }, ...Object.entries(NOMBRES).map(([valor, texto]) => ({ valor, texto }))]}
    />
    <p class="text-sm text-suave mt-2 mb-3 tabular-nums" aria-live="polite" data-resumen></p>

    <div class="flex flex-wrap items-baseline justify-between gap-2 text-sm mb-2">
      <p class="tabular-nums font-semibold" data-contador></p>
      <p class="tabular-nums text-suave" data-meta></p>
    </div>

    <article class="tarjeta">
      <p class="rotulo-caso mb-3">Caso de práctica elaborado para este sitio; no es una pregunta de la prueba.</p>
      <p class="tarjeta-repaso-etiqueta" data-nombre-caso></p>
      <p class="mt-1 leading-relaxed" data-situacion></p>
      <p class="mt-3 text-lg font-bold leading-snug" id="pregunta-caso" data-pregunta></p>
      <ul class="mt-4 space-y-2" aria-labelledby="pregunta-caso">
        {
          ['A', 'B', 'C'].map((letra, i) => (
            <li>
              <button type="button" class="opcion-quiz" data-opcion={i}>
                <span class="opcion-letra" aria-hidden="true">
                  {letra}
                </span>
                <span class="sr-only">{letra}:</span>
                <span class="flex-1 text-left" data-texto />
                <span class="opcion-marca" data-marca />
              </button>
            </li>
          ))
        }
      </ul>
    </article>
    <p class="sr-only" aria-live="assertive" data-anuncio></p>

    <section class="tarjeta mt-3 bg-primario-suave scroll-mb-24" aria-labelledby="titulo-explicacion" data-explicacion hidden>
      <h2 id="titulo-explicacion" class="font-bold">Por qué</h2>
      <p class="mt-1" data-explicacion-texto></p>
      <ul class="mt-2 text-sm space-y-1" data-fuentes></ul>
      <button type="button" class="boton boton-primario mt-3" data-siguiente>Siguiente caso</button>
    </section>
    <p class="hidden sm:block text-xs text-suave mt-2">Teclado: 1, 2, 3 o A, B, C para responder; Enter para seguir.</p>
  </div>

  <div id="fin-casos" class="tarjeta" hidden>
    <p class="text-xl font-bold">Respondió todos los casos de este filtro.</p>
    <p class="mt-1 text-suave">Puede empezar de nuevo: los que falló aparecen primero.</p>
    <p class="mt-4 flex flex-wrap gap-3">
      <button type="button" class="boton boton-primario" data-reiniciar>Empezar de nuevo</button>
      <a href={ruta('/repasar')} class="boton">Volver a Repasar</a>
    </p>
  </div>
</Base>

<script>
  import { CLAVES, almacenDisponible, escribir, leer } from '../../lib/almacen';
  import { alCambiarChip, marcarChip } from '../../lib/chips';
  import { avanceVigente, casoDeLaUrl, CASOS, ordenarCasos, registrarCaso, resumenCasos, type Caso } from '../../lib/casos';
  import { hoy, pasoLaPrueba } from '../../lib/repaso-cliente';
  import { avanceDeHoy, metaValida, sumar, type Registro } from '../../lib/racha';

  interface CasoDatos {
    id: string;
    caso: Caso;
    situacion: string;
    pregunta: string;
    opciones: [string, string, string];
    correcta: number;
    explicacion: string;
    fuentes: { norma: string; url: string }[];
  }

  const NOMBRES: Record<Caso, string> = { A: 'Caso A · Fiscalización', B: 'Caso B · Cobranzas', C: 'Caso C · Jurídica', D: 'Caso D · Aduanas y cambiario', T: 'Tronco común' };
  const LETRAS = ['A', 'B', 'C'];
  const dia = hoy();
  let todos: CasoDatos[] = [];
  try {
    todos = JSON.parse(document.getElementById('datos-casos')?.textContent ?? '[]');
  } catch {
    /* sin casos */
  }

  const raiz = document.getElementById('casos')!;
  const fin = document.getElementById('fin-casos')!;
  const grupo = document.getElementById('chips-caso')!;
  const opciones = [...raiz.querySelectorAll<HTMLButtonElement>('[data-opcion]')];
  const explicacion = raiz.querySelector<HTMLElement>('[data-explicacion]')!;
  const botonSiguiente = raiz.querySelector<HTMLButtonElement>('[data-siguiente]')!;
  const anuncio = raiz.querySelector<HTMLElement>('[data-anuncio]')!;
  document.getElementById('aviso-almacen')!.hidden = almacenDisponible();

  let avance = avanceVigente(leer<unknown>(CLAVES.casosAvance, {}), todos.map((c) => c.id));
  const registroGuardado = leer<unknown>(CLAVES.repasoDias, {});
  let registro: Registro = registroGuardado && typeof registroGuardado === 'object' ? (registroGuardado as Registro) : {};
  const meta = metaValida(leer<unknown>(CLAVES.repasoMeta, null));

  let filtro = casoDeLaUrl(location.search);
  let cola: CasoDatos[] = [];
  let i = 0;
  let respondido = false;
  /** Orden en que se muestran las opciones del caso actual (índices originales). */
  let orden: number[] = [0, 1, 2];

  function mezclar<T>(lista: T[]): T[] {
    for (let j = lista.length - 1; j > 0; j--) {
      const k = Math.floor(Math.random() * (j + 1));
      [lista[j], lista[k]] = [lista[k]!, lista[j]!];
    }
    return lista;
  }

  function pintarResumen() {
    const r = resumenCasos(todos, avance);
    const casos = filtro === 'todos' ? CASOS : [filtro];
    raiz.querySelector('[data-resumen]')!.textContent = casos.map((c) => `${c === 'T' ? 'Tronco' : c}: ${r[c].acertados} de ${r[c].total} acertados`).join(' · ');
    const oculta = pasoLaPrueba(dia);
    raiz.querySelector('[data-meta]')!.textContent = oculta ? '' : `Meta de hoy: ${Math.min(avanceDeHoy(registro, dia), meta)} de ${meta}`;
  }

  function empezar() {
    cola = ordenarCasos(todos, avance, filtro);
    i = 0;
    fin.hidden = true;
    raiz.hidden = false;
    mostrar();
  }

  function mostrar() {
    const c = cola[i];
    pintarResumen();
    if (!c) {
      raiz.querySelector<HTMLElement>('article')!.hidden = true;
      explicacion.hidden = true;
      fin.hidden = false;
      return;
    }
    raiz.querySelector<HTMLElement>('article')!.hidden = false;
    respondido = false;
    orden = mezclar([0, 1, 2]);
    raiz.querySelector('[data-contador]')!.textContent = `Caso ${i + 1} de ${cola.length}`;
    raiz.querySelector('[data-nombre-caso]')!.textContent = NOMBRES[c.caso];
    raiz.querySelector('[data-situacion]')!.textContent = c.situacion;
    raiz.querySelector('[data-pregunta]')!.textContent = c.pregunta;
    opciones.forEach((b, k) => {
      b.disabled = false;
      b.classList.remove('correcta', 'incorrecta');
      b.querySelector('[data-texto]')!.textContent = c.opciones[orden[k]!]!;
      b.querySelector('[data-marca]')!.textContent = '';
    });
    explicacion.hidden = true;
    anuncio.textContent = '';
  }

  function elegir(k: number) {
    const c = cola[i];
    if (!c || respondido) return;
    respondido = true;
    const posCorrecta = orden.indexOf(c.correcta);
    const acierto = k === posCorrecta;
    opciones.forEach((b) => (b.disabled = true));
    opciones[posCorrecta]!.classList.add('correcta');
    opciones[posCorrecta]!.querySelector('[data-marca]')!.textContent = 'Correcta';
    if (!acierto) {
      opciones[k]!.classList.add('incorrecta');
      opciones[k]!.querySelector('[data-marca]')!.textContent = 'Su respuesta';
    }
    anuncio.textContent = acierto ? 'Correcta.' : `La correcta era ${LETRAS[posCorrecta]}.`;

    avance = registrarCaso(avance, c.id, acierto);
    escribir(CLAVES.casosAvance, avance);
    registro = sumar(registro, dia);
    escribir(CLAVES.repasoDias, registro);

    explicacion.querySelector('[data-explicacion-texto]')!.textContent = c.explicacion;
    explicacion.querySelector('[data-fuentes]')!.replaceChildren(
      ...c.fuentes.map((f) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = f.url;
        a.rel = 'noopener';
        a.textContent = `${f.norma} · texto oficial →`;
        li.append(a);
        return li;
      }),
    );
    explicacion.hidden = false;
    pintarResumen();
    explicacion.scrollIntoView({ block: 'nearest' });
    botonSiguiente.focus({ preventScroll: true });
  }

  opciones.forEach((b, k) => b.addEventListener('click', () => elegir(k)));
  botonSiguiente.addEventListener('click', () => {
    i++;
    mostrar();
    if (cola[i]) opciones[0]!.focus();
  });
  fin.querySelector('[data-reiniciar]')!.addEventListener('click', empezar);
  document.addEventListener('keydown', (ev) => {
    if (raiz.hidden || respondido || ev.altKey || ev.ctrlKey || ev.metaKey) return;
    if ((ev.target as HTMLElement).closest('input, textarea, select, dialog')) return;
    const t = ev.key.toLowerCase();
    const k = ['1', '2', '3'].includes(t) ? Number(t) - 1 : ['a', 'b', 'c'].indexOf(t);
    if (k >= 0) {
      ev.preventDefault();
      elegir(k);
    }
  });

  marcarChip(grupo, filtro);
  alCambiarChip(grupo, (valor) => {
    filtro = valor === 'todos' ? 'todos' : (valor as Caso);
    const url = new URL(location.href);
    if (filtro === 'todos') url.searchParams.delete('caso');
    else url.searchParams.set('caso', filtro);
    history.replaceState(history.state, '', url);
    empezar();
  });
  empezar();
</script>

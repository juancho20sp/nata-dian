---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Plegable from '../../components/Plegable.astro';
import { ruta } from '../../lib/ruta';

const reglas = new Map((await getCollection('reglas')).map((e) => [e.data.id, e.data]));
const orden = ['caso-a', 'caso-b', 'caso-c', 'caso-d', 'tronco'];
const lineas = (await getCollection('terminos'))
  .map((e) => e.data)
  .sort((a, b) => orden.indexOf(a.id) - orden.indexOf(b.id))
  .map((l) => ({
    ...l,
    pasos: l.pasos.map((p) => {
      const r = reglas.get(p.regla);
      if (!r) throw new Error(`Paso de ${l.id} con regla inexistente: ${p.regla}`);
      return { ...p, norma: r.norma, url: r.url, vigencia: r.ambasNormasAduaneras };
    }),
  }));
---

<Base titulo="Términos por caso" descripcion="Líneas de tiempo con los plazos de cada caso y su artículo, verificados en el texto oficial.">
  <nav aria-label="Migas" class="no-imprimir text-sm mb-1">
    <a href={ruta('/repasar')}>← Repasar</a>
  </nav>
  <h1 class="text-2xl font-bold mb-1">Términos por caso</h1>
  <p class="text-suave text-sm mb-4">
    Cada paso muestra el acto, su plazo y el artículo, con enlace al texto oficial. Los plazos se copiaron de la norma vigente.
  </p>

  {
    lineas.map((l) => (
      <Plegable
        id={l.id}
        titulo={l.titulo}
        resumen={`${l.pasos.length} pasos`}
        aviso={l.pasos.some((p) => p.vigencia) ? ['Vigencia'] : []}
      >
        {l.pasos.some((p) => p.vigencia) && (
          <p class="mb-3 rounded px-3 py-2 text-sm bg-aviso-fondo text-aviso-texto">
            El Decreto Ley 920 de 2023 fue derogado por la Ley 2586 de 2026 (19 de junio de 2026); la prueba solo incluye normas
            expedidas antes de esa fecha. En aduanas se citan ambas cuando coinciden.
          </p>
        )}
        <ol class="linea-terminos">
          {l.pasos.map((p) => (
            <li>
              <p class="font-semibold">{p.acto}</p>
              <p class="mt-0.5">
                <span class="font-bold text-primario">{p.plazo}</span>
                {p.desde && <span class="text-suave"> · {p.desde}</span>}
              </p>
              <p class="text-sm mt-0.5">
                {p.norma} ·{' '}
                <a href={p.url} rel="noopener">
                  texto oficial
                </a>
              </p>
            </li>
          ))}
        </ol>
      </Plegable>
    ))
  }
</Base>

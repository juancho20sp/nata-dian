---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prosa from '../components/Prosa.astro';
import LoEsencial from '../components/LoEsencial.astro';
import Plegable from '../components/Plegable.astro';
import Chips from '../components/Chips.astro';
import { TODOS, tiposDeEmpleo } from '../lib/filtros';

const areas = (await getCollection('normativa')).map((e) => e.data);
const tipos = tiposDeEmpleo(areas);
const paraQuien = (empleos: string[]) => (empleos.includes(TODOS) ? 'Para todos los empleos' : `Para: ${empleos.join(', ')}`);
---

<Base titulo="Normativa">
  <h1 class="text-3xl font-bold mb-2">Normativa</h1>

  <LoEsencial pagina="normativa" />

  <div class="mt-6 mb-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h2 class="text-xl font-bold" id="areas">Normas por área</h2>
    <a href="#origen" class="marca-aviso no-underline"><span aria-hidden="true">⚠</span> Lista construida</a>
  </div>
  <Chips
    id="chips-empleo"
    etiqueta="Filtrar por tipo de empleo"
    activo=""
    desplazable
    opciones={[{ valor: '', texto: 'Todos' }, ...tipos.map((t) => ({ valor: t, texto: t }))]}
  />
  <p class="text-sm text-suave mt-2 mb-3" aria-live="polite" id="conteo-areas">{areas.length} áreas</p>

  <div id="lista-areas" data-tipos={JSON.stringify(tipos)}>
    {
      areas.map((a) => (
        <div data-empleos={JSON.stringify(a.empleos)}>
          <Plegable id={`area-${a.id}`} titulo={a.area} resumen={paraQuien(a.empleos)} aviso={a.aviso} nivel="h3">
            <p>{a.normas}</p>
            {a.nota && <p class="mt-2 rounded px-3 py-2 text-sm bg-aviso-fondo text-aviso-texto">{a.nota}</p>}
            {a.enlace && (
              <p class="mt-2">
                <a href={a.enlace.url} rel="noopener">
                  {a.enlace.texto}
                </a>
              </p>
            )}
          </Plegable>
        </div>
      ))
    }
  </div>
  <div id="sin-areas" class="tarjeta" hidden>
    <p>Ninguna norma para este empleo.</p>
    <button type="button" class="boton mt-2" id="ver-todas">Ver todas</button>
  </div>

  <h2 class="text-xl font-bold mt-8 mb-2">Contexto</h2>
  <Prosa pagina="normativa-intro" id="origen" titulo="De dónde sale esta lista" />
  <Prosa pagina="contexto-normativo" id="contexto" />
</Base>

<script>
  import { alCambiarChip, marcarChip } from '../lib/chips';
  import { areaVisible, empleoDeLaUrl } from '../lib/filtros';

  const lista = document.getElementById('lista-areas')!;
  const grupo = document.getElementById('chips-empleo')!;
  const conteo = document.getElementById('conteo-areas');
  const vacio = document.getElementById('sin-areas')!;
  const bloques = [...lista.querySelectorAll<HTMLElement>(':scope > [data-empleos]')];
  let tipos: string[] = [];
  try {
    tipos = JSON.parse(lista.dataset.tipos ?? '[]');
  } catch {
    /* sin tipos: no se filtra */
  }

  function filtrar(empleo: string | null) {
    let visibles = 0;
    for (const b of bloques) {
      let empleos: string[] = [];
      try {
        empleos = JSON.parse(b.dataset.empleos ?? '[]');
      } catch {
        /* área sin empleos */
      }
      b.hidden = !areaVisible(empleos, empleo);
      if (!b.hidden) visibles++;
    }
    if (conteo) conteo.textContent = `${visibles} ${visibles === 1 ? 'área' : 'áreas'}${empleo ? ` para ${empleo}` : ''}`;
    vacio.hidden = visibles > 0;
    const url = new URL(location.href);
    if (empleo) url.searchParams.set('empleo', empleo);
    else url.searchParams.delete('empleo');
    history.replaceState(history.state, '', url);
  }

  const inicial = empleoDeLaUrl(location.search, tipos);
  marcarChip(grupo, inicial ?? '');
  if (inicial) filtrar(inicial);
  alCambiarChip(grupo, (valor) => filtrar(valor || null));
  document.getElementById('ver-todas')?.addEventListener('click', () => {
    marcarChip(grupo, '');
    filtrar(null);
  });
</script>

---
import Base from '../layouts/Base.astro';
import { planesSeleccionables, troncoComun, PLAN_POR_DEFECTO } from '../lib/datos';
import { rangoLegible, FECHA_PRUEBA } from '../lib/fechas';
import { ruta } from '../lib/ruta';

const planes = await planesSeleccionables();
const tronco = await troncoComun();
const datosPlanes = JSON.stringify(
  Object.fromEntries(planes.map((p) => [p.slug, p.semanas.map(({ id, inicio, fin }) => ({ id, inicio, fin }))])),
);
---

<Base titulo="Hoy" sinIndice>
  <header class="mb-5">
    <h1 class="text-3xl font-bold">Hoy</h1>
    <p class="text-lg text-suave mt-1" id="fecha-hoy" aria-live="polite">&nbsp;</p>
  </header>

  <div class="mb-6 flex flex-wrap items-center gap-3">
    <label for="selector-plan" class="font-semibold">Plan</label>
    <select
      id="selector-plan"
      class="min-h-11 rounded-lg border border-borde bg-superficie text-texto px-3 py-2 max-w-full"
    >
      {planes.map((p) => <option value={p.slug} selected={p.slug === PLAN_POR_DEFECTO}>{p.tituloCorto}</option>)}
    </select>
    <a href={ruta('/planes')} class="text-sm">¿Cuál elegir?</a>
  </div>

  <noscript>
    <p class="tarjeta mb-6">Esta página necesita JavaScript para saber la fecha. Consulte las semanas en <a href={ruta('/planes')}>Planes</a>.</p>
  </noscript>

  <div id="paneles" data-planes={datosPlanes} data-fecha-prueba={FECHA_PRUEBA}>
    {
      planes.map((p) =>
        p.semanas.map((s, i) => (
          <section class="tarjeta border-l-4 border-l-primario mb-6" data-panel={`${p.slug}:${s.id}`} hidden>
            <p class="text-sm font-semibold uppercase tracking-wide text-suave">
              Semana {i + 1} de {p.semanas.length} · {rangoLegible(s.inicio, s.fin)}
            </p>
            <h2 class="text-2xl font-bold mt-1">{s.temas}</h2>
            {s.horas && <p class="text-suave mt-1">≈ {s.horas} horas en la semana</p>}
            {s.normas.length > 0 && (
              <div class="mt-3">
                <h3 class="font-semibold">Normas</h3>
                <ul class="list-disc pl-5">
                  {s.normas.map((n) =>
                    n === 'Ver tabla del tronco común' ? (
                      <li>
                        <a href={ruta('/planes/tronco-comun')}>Ver tabla del tronco común</a>
                      </li>
                    ) : (
                      <li>{n}</li>
                    ),
                  )}
                </ul>
                {p.notaNormas && <p class="text-sm text-suave mt-1">{p.notaNormas}.</p>}
              </div>
            )}
            {s.tronco === 'estudio' && s.normas.length === 0 && (
              <p class="mt-3">
                <a href={ruta('/planes/tronco-comun')}>Ver tabla del tronco común</a>
              </p>
            )}
            {s.tronco === 'repaso' && (
              <p class="mt-3 text-suave">
                Esta semana también se repasa el <a href={ruta('/planes/tronco-comun')}>tronco común</a>.
              </p>
            )}
            <p class="mt-4">
              <a href={ruta(`/planes/${p.slug}`)} class="boton">Ver el plan completo y marcar avance</a>
            </p>
          </section>
        )),
      )
    }

    <section class="tarjeta mb-6" data-panel="antes" hidden>
      <h2 class="text-2xl font-bold">El plan aún no empieza</h2>
      <p class="mt-1">Los planes van del 12 de octubre al 7 de noviembre de 2026. La primera semana es el tronco común.</p>
      <p class="mt-3"><a href={ruta('/planes/tronco-comun')} class="boton">Ver el tronco común</a></p>
    </section>

    <section class="tarjeta border-l-4 border-l-aviso-borde mb-6" data-panel="prueba" hidden>
      <h2 class="text-2xl font-bold">Hoy es la prueba</h2>
      <p class="mt-1">
        Puertas abren 7:15 a. m., inicio 8:00 a. m., cierre de puertas 8:30 a. m. Lleve lápiz N.º 2, sacapuntas, borrador y
        su documento de identidad.
      </p>
      <p class="mt-3"><a href={ruta('/prueba#logistica')} class="boton boton-primario">Repasar la logística del día</a></p>
    </section>

    <section class="tarjeta mb-6" data-panel="despues" hidden>
      <h2 class="text-2xl font-bold">La prueba ya pasó</h2>
      <p class="mt-1">
        Reclamaciones: solo por SIMO, dentro de los 5 días hábiles siguientes a la publicación de resultados; se puede
        pedir acceso a la prueba y completar la reclamación en 2 días hábiles.
      </p>
    </section>

    <section class="tarjeta mb-6" data-panel="hueco" hidden>
      <h2 class="text-2xl font-bold">No hay una semana asignada para hoy</h2>
      <p class="mt-1">Revise el plan completo.</p>
    </section>
  </div>

  <section aria-labelledby="titulo-rutina" id="rutina" hidden>
    <h2 id="titulo-rutina" class="text-2xl font-bold mb-2">Rutina de hoy</h2>
    <p class="tarjeta bg-primario-suave font-semibold mb-3" data-domingo hidden>
      Hoy es domingo: toca simulacro cronometrado.
    </p>
    <p class="text-suave mb-3">{tronco.rutina?.horas}.</p>
    <ol class="space-y-2">
      {
        tronco.rutina?.pasos.map((paso, i) => (
          <li class="tarjeta flex gap-3" data-paso={i}>
            <span class="font-bold text-primario tabular-nums">{i + 1}.</span>
            <span>{paso}</span>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<script>
  import { CLAVES, escribir, leer } from '../lib/almacen';
  import { diaDeLaSemana, fechaEnColombia, fechaLarga, semanaActual, type RangoSemana } from '../lib/fechas';

  const POR_DEFECTO = 'por-defecto';
  const contenedor = document.getElementById('paneles')!;
  const selector = document.getElementById('selector-plan') as HTMLSelectElement;
  const rutina = document.getElementById('rutina')!;
  const avisoDomingo = rutina.querySelector<HTMLElement>('[data-domingo]');
  const paneles = [...contenedor.querySelectorAll<HTMLElement>('[data-panel]')];

  let planes: Record<string, RangoSemana[]> = {};
  try {
    planes = JSON.parse(contenedor.dataset.planes ?? '{}');
  } catch {
    /* sin datos */
  }
  const fechaPrueba = contenedor.dataset.fechaPrueba ?? '';

  function mostrar(clave: string) {
    for (const p of paneles) p.hidden = p.dataset.panel !== clave;
  }

  function pintar(slug: string) {
    const ahora = new Date();
    const hoy = fechaEnColombia(ahora);
    const fecha = document.getElementById('fecha-hoy');
    if (fecha) {
      const texto = fechaLarga(hoy);
      fecha.textContent = `${texto.charAt(0).toUpperCase()}${texto.slice(1)} de ${hoy.slice(0, 4)} (hora de Colombia)`;
    }

    const semanas = planes[slug] ?? planes[POR_DEFECTO] ?? [];
    if (semanas.length === 0) return;
    const r = semanaActual(semanas, ahora);
    let enPlan = false;
    if (r.estado === 'durante') {
      mostrar(`${slug}:${r.semana.id}`);
      enPlan = true;
    } else if (r.estado === 'antes') {
      mostrar('antes');
    } else if (r.estado === 'hueco') {
      mostrar('hueco');
    } else {
      mostrar(hoy === fechaPrueba ? 'prueba' : 'despues');
    }
    rutina.hidden = !enPlan;
    if (avisoDomingo) avisoDomingo.hidden = diaDeLaSemana(hoy) !== 0;
  }

  const guardado = leer<string>(CLAVES.plan, POR_DEFECTO);
  const inicial = guardado in planes ? guardado : POR_DEFECTO;
  selector.value = inicial;
  pintar(inicial);

  selector.addEventListener('change', () => {
    escribir(CLAVES.plan, selector.value);
    pintar(selector.value);
  });
</script>
